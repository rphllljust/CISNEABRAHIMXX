# Copy to .env locally. Never commit real credentials.
CISNE_DB_USER=odoo
CISNE_DB_PASSWORD=change-me
CISNE_HTTP_PORT=8069
CISNE_WITHOUT_DEMO=true

# Governed default: stable/mature base only.
# Beta Brazilian NF-e/accounting bridges are intentionally not auto-installed.
CISNE_BOOTSTRAP_MODULES=base,web,mail,contacts,sale_management,purchase,stock,account,project,maintenance,fleet,hr_timesheet,contract,fieldservice,l10n_br_base,l10n_br_fiscal,cisne_branding
